{
  "$ref": "#/definitions/Element",
  "definitions": {
    "Element": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.1",
          "default": "0.1"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z][a-z]?$"
        },
        "atomicNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 118
        },
        "nameKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
          "description": "i18n key, e.g. \"element.hydrogen.name\"."
        }
      },
      "required": [
        "symbol",
        "atomicNumber",
        "nameKey"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
