{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": "0.1",
      "type": "string",
      "const": "0.1"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][a-z]?$"
    },
    "atomicNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 118
    },
    "nameKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
      "description": "i18n key, e.g. \"element.hydrogen.name\"."
    }
  },
  "required": [
    "symbol",
    "atomicNumber",
    "nameKey"
  ],
  "additionalProperties": false
}
