{
  "name": "@chemistrylab/web",
  "private": true,
  "version": "0.1.0",
  "description": "The ChemistryLab OS playground: balance and explore reactions in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "lint": "eslint src e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chemistrylab/chemspec": "workspace:*",
    "@chemistrylab/core": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
